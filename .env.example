# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin magic-link email (must match the address you log in with)
ADMIN_EMAIL=you@example.com

# Public site URL (used for invite links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Optional: Anthropic key for monthly show refresh cron (Phase 5)
# ANTHROPIC_API_KEY=

# Optional: protect the cron route (set the same value in Vercel Cron headers)
# CRON_SECRET=
